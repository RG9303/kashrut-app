{
    "buildCommand": "npm --prefix frontend install && npm --prefix frontend run build",
    "outputDirectory": "frontend/.next",
    "framework": "nextjs",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/app.py"
        },
        {
            "source": "/(.*)",
            "destination": "/frontend/$1"
        }
    ],
    "functions": {
        "api/**/*.py": {
            "maxDuration": 60
        }
    }
}